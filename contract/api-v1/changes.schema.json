{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "changes.schema.json",
  "title": "api/v1/changes.json",
  "description": "What moved, what was new and what CBE restated, day by day, newest first, read from this repository's own history.",
  "type": "object",
  "required": ["generated", "window_days", "days"],
  "properties": {
    "generated": {"type": "string"},
    "window_days": {"type": "integer"},
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date"],
        "properties": {
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "moved": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["series_id", "period", "value"],
              "properties": {
                "series_id": {"type": "string"},
                "period": {"type": "string"},
                "value": {"type": "number"},
                "previous": {"type": ["number", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
