{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "latest.schema.json",
  "title": "api/v1/latest.json",
  "description": "The newest value of every series in one small file, so an app checks this instead of hundreds of files. data_version changes when, and only when, any value in it changes.",
  "type": "object",
  "required": ["api", "data_version", "built", "series"],
  "properties": {
    "api": {"type": "string", "enum": ["v1"]},
    "data_version": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "built": {"type": "string", "description": "When this file was written, UTC, ISO 8601."},
    "series": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["period", "value"],
        "properties": {
          "period": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "value": {"type": "number"},
          "previous_period": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                              "description": "Absent for a one-point series."},
          "previous_value": {"type": "number", "description": "Absent for a one-point series."}
        }
      }
    }
  }
}
