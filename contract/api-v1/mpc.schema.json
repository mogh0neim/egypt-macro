{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mpc.schema.json",
  "title": "api/v1/mpc.json",
  "description": "Every Monetary Policy Committee statement on file, oldest first, and how each differs from the one before.",
  "type": "object",
  "required": ["count", "range", "statements", "diffs"],
  "properties": {
    "count": {"type": "integer"},
    "range": {"type": "array", "minItems": 2, "maxItems": 2,
              "items": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}},
    "statements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "title", "url", "format"],
        "properties": {
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "title": {"type": "string"},
          "url": {"type": "string", "pattern": "^https://"},
          "format": {"type": "string"},
          "decision": {"type": ["string", "null"], "enum": ["hold", "hike", "cut", null],
                       "description": "Optional. Absent when it could not be read from the statement."},
          "basis_points": {"type": "integer", "description": "Optional. The size of the move, when stated."},
          "deposit_rate": {"type": "number", "description": "Optional, percent. As are the three rates below."},
          "lending_rate": {"type": "number"},
          "main_operation_rate": {"type": "number"},
          "discount_rate": {"type": "number"}
        }
      }
    },
    "diffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_date", "to_date", "rate_move"],
        "properties": {
          "from_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "to_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "similarity": {"type": "number"},
          "rate_move": {"type": ["object", "null"],
                        "additionalProperties": {
                          "type": "object",
                          "required": ["from", "to", "change"],
                          "properties": {"from": {"type": "number"}, "to": {"type": "number"},
                                         "change": {"type": "number"}}
                        }}
        }
      }
    }
  }
}
