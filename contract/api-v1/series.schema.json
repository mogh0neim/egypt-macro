{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "series.schema.json",
  "title": "api/v1/series/{series_id}.json",
  "description": "One series in full: its description and every observation, oldest first.",
  "type": "object",
  "required": ["series_id", "title_en", "title_ar", "unit", "freq", "family",
               "source_url", "derived", "observations", "count", "attribution"],
  "properties": {
    "series_id": {"type": "string", "pattern": "^EG\\.[A-Za-z0-9_.-]+$"},
    "title_en": {"type": "string"},
    "title_ar": {"type": ["string", "null"]},
    "title_ar_source": {"type": ["string", "null"]},
    "unit": {"type": ["string", "null"]},
    "freq": {"type": "string"},
    "family": {"type": "string"},
    "dataset": {"type": ["string", "null"]},
    "source_url": {"type": ["string", "null"], "description": "The CBE page the numbers come from."},
    "source_file": {"type": ["string", "null"]},
    "derived": {"type": ["boolean", "null"], "description": "true when Miqyas computed the series from CBE data; see method."},
    "method": {"type": ["string", "null"]},
    "note": {"type": ["string", "null"]},
    "observations": {
      "type": "array",
      "minItems": 1,
      "description": "[date, value] pairs, oldest first.",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          {"type": "number"}
        ]
      }
    },
    "count": {"type": "integer", "minimum": 1},
    "attribution": {"type": "string", "description": "Show this wherever the numbers are shown."}
  }
}
