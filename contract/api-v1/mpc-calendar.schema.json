{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mpc-calendar.schema.json",
  "title": "api/v1/mpc_calendar.json",
  "description": "When the Monetary Policy Committee meets, as CBE publishes it. Next year's dates appear late in the current year.",
  "type": "object",
  "required": ["source_url", "checked_on", "meetings"],
  "properties": {
    "source_url": {"type": "string"},
    "checked_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "meetings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date"],
        "properties": {
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "year": {"type": "integer"}
        }
      }
    }
  }
}
